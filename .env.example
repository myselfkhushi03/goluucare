# Add these in Vercel > Project > Settings > Environment Variables
GOLUUU_API_KEY=change-me-long-random
GOLUUU_AES_KEY=      # base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash
# /tmp is wiped on cold starts - use a real DB for persistence (Postgres/Turso):
# DATABASE_URL=postgresql+psycopg2://user:pass@host/db
